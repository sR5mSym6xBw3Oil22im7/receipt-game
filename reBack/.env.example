PORT=8081
DB_HOST=localhost
DB_PORT=5432
DB_NAME=receipt_db
DB_USER=postgres
DB_PASSWORD=replace-locally
ADMIN_USERNAME=replace-locally
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_COOKIE_SECURE=false
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# GEMINI_API_DEFAULT は必須。未設定の場合、バックエンドは起動しません。
# PLAYER1 / PLAYER2 / MONSTER / ANALYZE は任意。未設定なら GEMINI_API_DEFAULT を使い、設定すればそちらを優先します。
GEMINI_API_DEFAULT=
GEMINI_API_PLAYER1=
GEMINI_API_PLAYER2=
GEMINI_API_MONSTER=
GEMINI_API_ANALYZE=
